    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
    <PackageReference Include="Supabase" Version="8.14.0" />
    <PackageReference Include="Supabase.Extensions.DependencyInjection" Version="8.14.0" />
