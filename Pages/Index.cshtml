@page
@model StudentManagementSystem.Pages.IndexModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Student Management Dashboard</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f4f6fb;
            color: #1e293b;
        }

        .sidebar {
            width: 240px;
            height: 100vh;
            position: fixed;
            background: #172554;
            color: white;
            padding: 30px 20px;
        }

        .sidebar h2 {
            font-size: 21px;
            margin-bottom: 45px;
        }

        .sidebar a {
            display: block;
            color: white;
            text-decoration: none;
            padding: 14px;
            margin-bottom: 10px;
            border-radius: 8px;
            background: #1e3a8a;
        }

        .main {
            margin-left: 240px;
            padding: 35px;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }

        .header h1 {
            margin: 0;
            font-size: 28px;
        }

        .cards {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 20px;
            margin-bottom: 35px;
        }

        .card {
            background: white;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 3px 12px #0000000a;
        }

        .card p {
            color: #64748b;
            margin: 0 0 12px;
        }

        .card h2 {
            font-size: 32px;
            margin: 0;
            color: #1d4ed8;
        }

        .table-container {
            background: white;
            padding: 25px;
            border-radius: 12px;
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        th, td {
            padding: 15px;
            text-align: left;
            border-bottom: 1px solid #e2e8f0;
        }

        th {
            color: #64748b;
            font-size: 13px;
        }

        .empty {
            text-align: center;
            color: #64748b;
            padding: 25px;
        }

        @@media (max-width: 700px) {
            .sidebar {
                width: 100%;
                height: auto;
                position: relative;
            }

            .sidebar h2 {
                margin-bottom: 15px;
            }

            .main {
                margin-left: 0;
                padding: 20px;
            }

            .cards {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>

    <aside class="sidebar">
        <h2>Student System</h2>
        <a href="/">Dashboard</a>
    </aside>

    <main class="main">

        <header class="header">
            <h1>Dashboard</h1>
            <span>Student Management System</span>
        </header>

        <section class="cards">

            <div class="card">
                <p>Total Students</p>
                <h2>@Model.TotalStudents</h2>
            </div>

            <div class="card">
                <p>Total Careers</p>
                <h2>@Model.TotalCareers</h2>
            </div>

        </section>

        <section class="table-container">

            <h2>Registered Students</h2>

            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>First Name</th>
                        <th>Last Name</th>
                        <th>Email</th>
                        <th>Career</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Students.Any())
                    {
                        @foreach (var student in Model.Students)
                        {
                            <tr>
                                <td>@student.Id</td>
                                <td>@student.FirstName</td>
                                <td>@student.LastName</td>
                                <td>@student.Email</td>
                                <td>@student.Career</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="empty">
                                No students registered yet.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </section>

    </main>

</body>
</html>
